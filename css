* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #2b2b2b;
    color: white;
    padding: 20px;
}

.container {
    max-width: 900px;
    margin: 0 auto;
}

header {
    text-align: center;
    margin-bottom: 30px;
}

h1 {
    font-size: 2.5rem;
    color: #ffcc00;
}

.miner-login {
    text-align: center;
}

.miner-login input {
    padding: 10px;
    font-size: 1rem;
    margin-right: 10px;
    width: 250px;
}

.miner-login button {
    padding: 10px 20px;
    background-color: #00cc66;
    border: none;
    color: white;
    cursor: pointer;
    font-size: 1rem;
}

.miner-login button:hover {
    background-color: #009933;
}

.dashboard {
    background-color: #333;
    padding: 20px;
    border-radius: 8px;
    margin-top: 20px;
}

.miner-info {
    margin-bottom: 20px;
}

.mining-stats {
    margin: 20px 0;
}

button {
    background-color: #00bfff;
    padding: 10px 20px;
    font-size: 1.2rem;
    border: none;
    color: white;
    cursor: pointer;
}

button:hover {
    background-color: #0086b3;
}

footer {
    text-align: center;
    margin-top: 50px;
}
